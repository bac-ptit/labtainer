# Filename : start.config
# Description:
#     Single Sign-On (SSO) Kerberos TGS Kerberoasting Attack & Defense Lab (MITRE ATT&CK T1558.003)
#     Demonstrates TGS service ticket extraction, offline dictionary cracking of weak service passwords,
#     and remediation via complex password rotation and AES-256 cryptographic enforcement.

GLOBAL_SETTINGS
    REGISTRY hoangbac2004
    GRADE_CONTAINER client
    HOST_HOME_XFER seed_dir/
    LAB_MASTER_SEED sso_kerberoasting_master_seed
    COLLECT_DOCS YES

# Virtual LAN Network
NETWORK LAN
    MASK 172.25.0.0/24
    GATEWAY 172.25.0.101

# Containers
CONTAINER kdc
    USER admin
    PASSWORD password123
    SCRIPT NONE
    TERMINALS 0
    ADD-HOST LAN
    LAN 172.25.0.10

CONTAINER web
    USER admin
    PASSWORD password123
    SCRIPT NONE
    TERMINALS 0
    WAIT_FOR kdc
    ADD-HOST LAN
    LAN 172.25.0.20

CONTAINER client
    USER alice
    PASSWORD Password123!
    SCRIPT NONE
    X11 YES
    TERMINALS 1
    TERMINAL_GROUP client
    WAIT_FOR web
    ADD-HOST LAN
    LAN 172.25.0.50
