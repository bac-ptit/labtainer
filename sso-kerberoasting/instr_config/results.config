# results.config for sso-kerberoasting
# Evaluates Kerberoasting attack, offline cracking, remediation, and Web SPNEGO SSO

tgs_ticket_acquired = client:/tmp/klist.txt : CONTAINS : HTTP/web.lab.lan@LAB.LAN
web_sso_flag = client:/tmp/kerberoast_web_response.txt : CONTAINS : FLAG_KERBEROAST_SSO_448192
service_hash_cracked = client:~/.kerberoast_verified.log : CONTAINS : SERVICE_HASH_CRACKED_SUCCESS
complex_key_remediated = client:~/.kerberoast_verified.log : CONTAINS : COMPLEX_PASSWORD_REMEDIATED
aes256_enforced = client:~/.kerberoast_verified.log : CONTAINS : AES256_ENCRYPTION_ENFORCED
