# Filename : start.config
# Description:
#     Single Sign-On (SSO) Kerberos Multi-tier Delegation Lab
#     Models enterprise 3-tier identity realm, HTTP SPNEGO delegation to Backend DB,
#     Unconstrained Delegation risk analysis, and Constrained Delegation (S4U2Proxy) defense.

GLOBAL_SETTINGS
    REGISTRY hoangbac2004
    GRADE_CONTAINER client
    HOST_HOME_XFER seed_dir/
    LAB_MASTER_SEED sso_delegation_master_seed
    COLLECT_DOCS YES

# Virtual LAN Network
NETWORK LAN
    MASK 172.25.0.0/24
    GATEWAY 172.25.0.101

# Containers
CONTAINER kdc
    USER admin
    PASSWORD password123
    SCRIPT NONE
    TERMINALS 0
    ADD-HOST LAN
    LAN 172.25.0.10

CONTAINER web
    USER admin
    PASSWORD password123
    SCRIPT NONE
    TERMINALS 0
    WAIT_FOR kdc
    ADD-HOST LAN
    LAN 172.25.0.20

CONTAINER db
    USER admin
    PASSWORD password123
    SCRIPT NONE
    TERMINALS 0
    WAIT_FOR kdc
    ADD-HOST LAN
    LAN 172.25.0.30

CONTAINER client
    USER alice
    PASSWORD Password123!
    SCRIPT NONE
    X11 YES
    TERMINALS 1
    TERMINAL_GROUP client
    WAIT_FOR web
    ADD-HOST LAN
    LAN 172.25.0.50
