# results.config for sso-delegation
# Evaluates student actions across Kerberos TGT, Multi-tier SSO Delegation, Risk Analysis, and Constrained Defense

tgt_acquired = client:/tmp/klist.txt : CONTAINS : krbtgt/LAB.LAN@LAB.LAN
web_ticket_acquired = client:/tmp/klist.txt : CONTAINS : HTTP/web.lab.lan@LAB.LAN
multitier_sso_access = client:/tmp/multitier_response.txt : CONTAINS : SALARY_FLAG_998124
delegation_risk_audited = client:~/.delegation_risk_audited.log : CONTAINS : DELEGATION_RISK_AUDITED
defense_verified = client:~/.defense_verified.log : CONTAINS : CONSTRAINED_DEFENSE_VERIFIED
