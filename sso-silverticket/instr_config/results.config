# results.config for sso-silverticket
# Evaluates Silver Ticket forgery, Keytab rotation remediation, and Web SSO

alice_sso_acquired = client:/tmp/klist.txt : CONTAINS : krbtgt/LAB.LAN@LAB.LAN
web_sso_flag = client:/tmp/silverticket_web_response.txt : CONTAINS : FLAG_SILVERTICKET_SSO_551928
silver_ticket_forged = client:~/.silverticket_verified.log : CONTAINS : SILVER_TICKET_FORGERY_SUCCESS
keytab_permission_secured = client:~/.silverticket_verified.log : CONTAINS : KEYTAB_PERMISSIONS_SECURED
keytab_rotation_remediated = client:~/.silverticket_verified.log : CONTAINS : KEYTAB_ROTATION_REMEDIATED
