[ ca ]
default_ca = CA_default

[ CA_default ]
dir = /tmp/pkinit_certs_gen/demoCA
database = /tmp/pkinit_certs_gen/demoCA/index.txt
new_certs_dir = /tmp/pkinit_certs_gen/demoCA/newcerts
certificate = /tmp/pkinit_certs_gen/ca_root.crt
serial = /tmp/pkinit_certs_gen/demoCA/serial
private_key = /tmp/pkinit_certs_gen/demoCA/private/cakey.pem
default_days = 3650
default_crl_days = 3650
default_md = sha256
policy = policy_anything

[ policy_anything ]
countryName = optional
stateOrProvinceName = optional
localityName = optional
organizationName = optional
organizationalUnitName = optional
commonName = supplied
emailAddress = optional

[ req ]
default_bits = 2048
prompt = no
distinguished_name = req_dn

[ req_dn ]
CN = Lab Root CA
O = CyberSec Lab
C = VN

[ v3_ca ]
basicConstraints = critical, CA:TRUE
keyUsage = critical, digitalSignature, cRLSign, keyCertSign
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always,issuer

[ rogue_ca ]
basicConstraints = critical, CA:TRUE
keyUsage = critical, digitalSignature, cRLSign, keyCertSign
subjectKeyIdentifier = hash

[ kdc_cert ]
basicConstraints = CA:FALSE
keyUsage = nonRepudiation, digitalSignature, keyEncipherment, keyAgreement
extendedKeyUsage = 1.3.6.1.5.2.3.5
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
subjectAltName = otherName:1.3.6.1.5.2.2;SEQUENCE:kdc_princ_name

[ kdc_princ_name ]
realm = EXP:0, GeneralString:LAB.LAN
principal_name = EXP:1, SEQUENCE:kdc_principal_seq

[ kdc_principal_seq ]
name_type = EXP:0, INTEGER:1
name_string = EXP:1, SEQUENCE:kdc_principals

[ kdc_principals ]
princ1 = GeneralString:krbtgt
princ2 = GeneralString:LAB.LAN

[ client_alice ]
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment, keyAgreement
extendedKeyUsage = 1.3.6.1.5.2.3.4
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
subjectAltName = otherName:1.3.6.1.5.2.2;SEQUENCE:princ_alice

[ princ_alice ]
realm = EXP:0, GeneralString:LAB.LAN
principal_name = EXP:1, SEQUENCE:principal_seq_alice

[ principal_seq_alice ]
name_type = EXP:0, INTEGER:1
name_string = EXP:1, SEQUENCE:principals_alice

[ principals_alice ]
princ1 = GeneralString:alice

[ client_bob ]
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment, keyAgreement
extendedKeyUsage = 1.3.6.1.5.2.3.4
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
subjectAltName = otherName:1.3.6.1.5.2.2;SEQUENCE:princ_bob

[ princ_bob ]
realm = EXP:0, GeneralString:LAB.LAN
principal_name = EXP:1, SEQUENCE:principal_seq_bob

[ principal_seq_bob ]
name_type = EXP:0, INTEGER:1
name_string = EXP:1, SEQUENCE:principals_bob

[ principals_bob ]
princ1 = GeneralString:bob
