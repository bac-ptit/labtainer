# Filename : start.config
# Description:
#     Single Sign-On (SSO) Kerberos Passwordless PKINIT Lab (RFC 4556)
#     Models enterprise Public Key Infrastructure (X.509 CA), Zero-Password KDC (-nokey),
#     Web SPNEGO and SSH SSO, CRL revocation checking, and 6-case security test matrix.

GLOBAL_SETTINGS
    GRADE_CONTAINER client
    HOST_HOME_XFER seed_dir/
    LAB_MASTER_SEED sso_pkinit_master_seed
    COLLECT_DOCS YES

# Virtual LAN Network
NETWORK LAN
    MASK 172.25.0.0/24
    GATEWAY 172.25.0.101

# Containers
CONTAINER ca
    USER admin
    PASSWORD password123
    SCRIPT NONE
    TERMINALS 0
    ADD-HOST LAN
    LAN 172.25.0.10

CONTAINER kdc
    USER admin
    PASSWORD password123
    SCRIPT NONE
    TERMINALS 0
    WAIT_FOR ca
    ADD-HOST LAN
    LAN 172.25.0.20

CONTAINER app
    USER admin
    PASSWORD password123
    SCRIPT NONE
    TERMINALS 0
    WAIT_FOR kdc
    ADD-HOST LAN
    LAN 172.25.0.30

CONTAINER client
    USER alice
    PASSWORD Password123!
    SCRIPT NONE
    X11 YES
    TERMINALS 1
    TERMINAL_GROUP client
    WAIT_FOR app
    ADD-HOST LAN
    LAN 172.25.0.50
