# results.config for sso-pkinit
# Evaluates student actions across PKINIT TGT, Web SSO, and the 6-case security test matrix

pkinit_tgt_acquired = client:/tmp/klist.txt : CONTAINS : krbtgt/LAB.LAN@LAB.LAN
pkinit_web_sso_access = client:/tmp/pkinit_web_response.txt : CONTAINS : FLAG_PKINIT_SSO_992147
untrusted_ca_blocked = client:~/.pkinit_matrix_verified.log : CONTAINS : UNTRUSTED_CA_BLOCKED
san_mismatch_blocked = client:~/.pkinit_matrix_verified.log : CONTAINS : SAN_MISMATCH_BLOCKED
crl_revocation_blocked = client:~/.pkinit_matrix_verified.log : CONTAINS : CRL_REVOCATION_BLOCKED
zero_password_verified = client:~/.pkinit_matrix_verified.log : CONTAINS : ZERO_PASSWORD_VERIFIED
