# results.config for sso-kerberos
# Evaluates student actions across Kerberos TGT, Web SSO, SSH SSO, and Attack Demo

tgt_acquired = client:/tmp/klist.txt : CONTAINS : krbtgt/LAB.LAN@LAB.LAN
web_ticket_acquired = client:/tmp/klist.txt : CONTAINS : HTTP/web.lab.lan@LAB.LAN
web_sso_access = web:/var/log/apache2/access.log : CONTAINS : /intranet/index.html
ssh_sso_access = ssh:/var/log/auth.log : CONTAINS : Accepted gssapi-with-mic for alice
asrep_cracked = client:~/.john/john.pot : CONTAINS : BackupPass2026!

defense_verified = client:~/.defense_verified.log : CONTAINS : DEFENSE_SUCCESSFUL
