# Filename : start.config
# Description:
#     Single Sign-On (SSO) Kerberos Cross-Realm Trust & Federation Lab (RFC 4120)
#     Demonstrates inter-realm ticket issuance, direct trust referral,
#     cross-realm Web SPNEGO & SSH SSO, and 5-case security test matrix.

GLOBAL_SETTINGS
    REGISTRY hoangbac2004
    GRADE_CONTAINER client
    HOST_HOME_XFER seed_dir/
    LAB_MASTER_SEED sso_crossrealm_master_seed
    COLLECT_DOCS YES

# Virtual LAN Network
NETWORK LAN
    MASK 172.25.0.0/24
    GATEWAY 172.25.0.101

# Containers
CONTAINER kdc-student
    USER admin
    PASSWORD password123
    SCRIPT NONE
    TERMINALS 0
    ADD-HOST LAN
    LAN 172.25.0.10

CONTAINER kdc-research
    USER admin
    PASSWORD password123
    SCRIPT NONE
    TERMINALS 0
    WAIT_FOR kdc-student
    ADD-HOST LAN
    LAN 172.25.0.20

CONTAINER app
    USER admin
    PASSWORD password123
    SCRIPT NONE
    TERMINALS 0
    WAIT_FOR kdc-research
    ADD-HOST LAN
    LAN 172.25.0.30

CONTAINER client
    USER alice
    PASSWORD Password123!
    SCRIPT NONE
    X11 YES
    TERMINALS 1
    TERMINAL_GROUP client
    WAIT_FOR app
    ADD-HOST LAN
    LAN 172.25.0.50
