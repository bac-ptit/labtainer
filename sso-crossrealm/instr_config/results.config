# results.config for sso-crossrealm
# Evaluates student actions across Cross-Realm SSO ticket referral, Web SPNEGO, and Security Test Matrix

crossrealm_referral_acquired = client:/tmp/klist.txt : CONTAINS : krbtgt/RESEARCH.LAB@STUDENT.LAB
crossrealm_web_sso_flag = client:/tmp/crossrealm_web_response.txt : CONTAINS : FLAG_CROSSREALM_SSO_771829
untrusted_realm_blocked = client:~/.crossrealm_matrix_verified.log : CONTAINS : UNTRUSTED_REALM_BLOCKED
transited_policy_enforced = client:~/.crossrealm_matrix_verified.log : CONTAINS : TRANSITED_POLICY_ENFORCED
authz_restriction_blocked = client:~/.crossrealm_matrix_verified.log : CONTAINS : AUTHZ_RESTRICTION_BLOCKED
strong_crypto_verified = client:~/.crossrealm_matrix_verified.log : CONTAINS : STRONG_CRYPTO_VERIFIED
