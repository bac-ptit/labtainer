# Filename : start.config
# Description:
#     Single Sign-On (SSO) Kerberos Pass-the-Ticket & Ccache Hardening Lab (MITRE ATT&CK T1558.001)
#     Demonstrates credential cache hijacking from flat files (/tmp/krb5cc_*),
#     lateral movement/session impersonation, and remediation via Linux Kernel Keyring.

GLOBAL_SETTINGS
    GRADE_CONTAINER workstation
    HOST_HOME_XFER seed_dir/
    LAB_MASTER_SEED sso_passtheticket_master_seed
    COLLECT_DOCS YES

# Virtual LAN Network
NETWORK LAN
    MASK 172.25.0.0/24
    GATEWAY 172.25.0.101

# Containers
CONTAINER kdc
    USER admin
    PASSWORD password123
    SCRIPT NONE
    TERMINALS 0
    ADD-HOST LAN
    LAN 172.25.0.10

CONTAINER app
    USER admin
    PASSWORD password123
    SCRIPT NONE
    TERMINALS 0
    WAIT_FOR kdc
    ADD-HOST LAN
    LAN 172.25.0.20

CONTAINER workstation
    USER alice
    PASSWORD Password123!
    SCRIPT NONE
    X11 YES
    TERMINALS 1
    TERMINAL_GROUP workstation
    WAIT_FOR app
    ADD-HOST LAN
    LAN 172.25.0.50
