# results.config for sso-passtheticket
# Evaluates Pass-the-Ticket exploitation, Kernel Keyring hardening, and Web SSO

alice_sso_acquired = workstation:/tmp/klist.txt : CONTAINS : krbtgt/LAB.LAN@LAB.LAN
web_sso_flag = workstation:/tmp/passtheticket_web_response.txt : CONTAINS : FLAG_PASSTHETICKET_SSO_882910
ccache_hijacked = workstation:~/.passtheticket_verified.log : CONTAINS : PASS_THE_TICKET_EXPLOITED_SUCCESS
keyring_remediated = workstation:~/.passtheticket_verified.log : CONTAINS : KERNEL_KEYRING_REMEDIATED
session_lifecycle_hardened = workstation:~/.passtheticket_verified.log : CONTAINS : SESSION_LIFECYCLE_HARDENED
