# results.config for sso-replay-skew
# Evaluates Clock Skew, Authenticator Replay Attack, Replay Cache Defense, and Web SSO

alice_sso_acquired = client:/tmp/klist.txt : CONTAINS : krbtgt/LAB.LAN@LAB.LAN
web_sso_flag = client:/tmp/replayskew_web_response.txt : CONTAINS : FLAG_REPLAY_SSO_339182
clock_skew_blocked = client:~/.replayskew_verified.log : CONTAINS : CLOCK_SKEW_REJECTED_SUCCESS
replay_attack_demonstrated = client:~/.replayskew_verified.log : CONTAINS : REPLAY_ATTACK_EXPLOITED_SUCCESS
replay_cache_remediated = client:~/.replayskew_verified.log : CONTAINS : REPLAY_CACHE_DEFENSE_SUCCESS
